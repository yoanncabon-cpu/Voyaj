{
  "expo": {
    "name": "Voyaj",
    "slug": "voyaj",
    "owner": "tansi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "voyaj",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.voyaj.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Voyaj utilise votre position pour trouver un chauffeur proche et suivre votre trajet.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "En mode chauffeur, Voyaj utilise votre position pour vous proposer des courses proches et la partager avec votre passager pendant le trajet.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.voyaj.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "backgroundColor": "#1B2550"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#15162A"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Voyaj utilise votre position pour trouver un chauffeur proche et suivre votre trajet.",
          "locationAlwaysAndWhenInUsePermission": "En mode chauffeur, Voyaj utilise votre position pour vous proposer des courses proches et la partager avec votre passager pendant le trajet."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3DDC97"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Voyaj accède à vos photos pour votre photo de profil et l'envoi de votre pièce d'identité.",
          "cameraPermission": "Voyaj utilise l'appareil photo pour photographier votre pièce d'identité.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Voyaj utilise Face ID pour sécuriser l'accès à votre compte."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa9999cd-878c-4387-8958-0d4530fca05f"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/fa9999cd-878c-4387-8958-0d4530fca05f"
    }
  }
}
