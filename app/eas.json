{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://REMPLACER.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "REMPLACER",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_REMPLACER"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REMPLACER_APPLE_ID"
      }
    }
  }
}
